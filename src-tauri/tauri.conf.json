{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperLine",
  "version": "0.2.1",
  "identifier": "io.github.applespriter.paperline",
  "build": {
    "frontendDist": "../static",
    "beforeBuildCommand": "npm run desktop:backend",
    "beforeDevCommand": "npm run desktop:backend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/paperline-backend"
    ],
    "category": "Productivity",
    "shortDescription": "A local workspace for reading research papers",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    }
  }
}
