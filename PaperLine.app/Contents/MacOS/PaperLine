#!/bin/sh
project_dir="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)" || exit 1
cd "$project_dir" || exit 1

for python_bin in /opt/homebrew/bin/python3 /usr/local/bin/python3 "$HOME/.pyenv/shims/python3" "$HOME/.asdf/shims/python3" /usr/bin/python3 "$(command -v python3 2>/dev/null)"; do
  if [ -n "$python_bin" ] && [ -x "$python_bin" ] && "$python_bin" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    exec "$python_bin" "$project_dir/launcher.py" "$@"
  fi
done

printf '%s\n' 'PaperLine 需要 Python 3.10 或更新版本。' >&2
/usr/bin/osascript -e 'display alert "PaperLine 无法启动" message "请先安装 Python 3.10 或更新版本，然后重新打开 PaperLine。"' >/dev/null 2>&1
exit 1
